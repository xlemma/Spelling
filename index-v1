        // ---------- BUILD WORD SOURCE MAP ----------
        // Maps each word (lowercase) to the earliest week it appears as a target word
        const wordSourceMap = {};
        const availableWeeks = Object.keys(grade1Data).map(Number).sort((a, b) => a - b);
        for (const w of availableWeeks) {
            for (const [word] of grade1Data[w]) {
                const key = word.toLowerCase();
                if (wordSourceMap[key] === undefined) {
                    wordSourceMap[key] = w;  // first occurrence
                }
            }
        }

        // Common stop/simple words (always treated as known — no tag)
        const commonWords = new Set([
            "a", "an", "i", "you", "he", "she", "it", "we", "they",
            "my", "your", "his", "her", "its", "our", "their",
            "am", "is", "are", "was", "were", "be", "been",
            "do", "does", "did", "have", "has", "had",
            "will", "would", "can", "could", "may", "might", "must",
            "this", "that", "these", "those", "the", "and", "or", "but", "so",
            "of", "to", "in", "on", "at", "by", "for", "with", "from",
            "up", "down", "out", "off", "over", "under", "again", "then",
            "here", "there", "when", "where", "why", "how", "what", "which", "who",
            "not", "no", "yes", "all", "some", "many", "more", "most",
            "one", "two", "three", "first", "next", "last", "good", "new", "old",
            "big", "small", "hot", "cold", "red", "blue", "green", "black", "white", "brown",
            "very", "too", "just", "only", "also", "well", "now", "please"
        ]);

        // ---------- STATE ----------
        let selectedWeeks = new Set();
        let currentWords = [];   // { id, text, week, sentence, checked, sentenceChecks: {wordIndex: bool} }
        let touchedIndexes = new Set();

        // DOM elements
        const weekGrid = document.getElementById('weekGrid');
        const loadBtn = document.getElementById('loadBtn');
        const resetBtn = document.getElementById('resetBtn');
        const downloadBtn = document.getElementById('downloadBtn');
        const wordListContainer = document.getElementById('wordListContainer');
        const resultSummary = document.getElementById('resultSummary');
        const scoreDisplay = document.getElementById('scoreDisplay');
        const scoreDetail = document.getElementById('scoreDetail');
        const toast = document.getElementById('toast');

        // ---------- TOAST ----------
        function showToast(message) {
            toast.textContent = message;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 2500);
        }

        // ---------- RENDER WEEK BUTTONS ----------
        function renderWeekButtons() {
            weekGrid.innerHTML = '';
            for (const w of availableWeeks) {
                const btn = document.createElement('button');
                btn.classList.add('week-btn');
                btn.textContent = `W${w}`;
                btn.dataset.week = w;
                if (selectedWeeks.has(w)) btn.classList.add('active');
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const week = parseInt(btn.dataset.week);
                    if (selectedWeeks.has(week)) {
                        selectedWeeks.delete(week);
                        btn.classList.remove('active');
                    } else {
                        selectedWeeks.add(week);
                        btn.classList.add('active');
                    }
                });
                weekGrid.appendChild(btn);
            }
        }

        // ---------- BUILD WORD LIST ----------
        function buildWordList() {
            if (selectedWeeks.size === 0) {
                currentWords = [];
                touchedIndexes.clear();
                renderWordList();
                resultSummary.classList.remove('show');
                return;
            }

            const newWords = [];
            const weeks = Array.from(selectedWeeks).sort((a, b) => a - b);

            for (const week of weeks) {
                const weekData = grade1Data[week];
                if (!weekData) continue;
                for (const [word, sentence] of weekData) {
                    const id = `g1-w${week}-${word}-${Math.random().toString(36).substring(2, 8)}`;
                    newWords.push({
                        id: id,
                        text: word,
                        week: week,
                        sentence: sentence,
                        checked: false,
                        sentenceChecks: {}  // index -> bool
                    });
                }
            }

            currentWords = newWords;
            touchedIndexes.clear();
            renderWordList();
            resultSummary.classList.remove('show');
            updateScoreSummary();
        }

        // ---------- SPLIT SENTENCE INTO WORD TOKENS ----------
        // Returns array of { token, isWord, clean }
        // Keeps punctuation attached to display but strips for lookup
        function tokenizeSentence(sentence) {
            const rawTokens = sentence.split(/(\s+)/); // keep spaces as tokens
            const result = [];
            for (const tok of rawTokens) {
                if (tok === '') continue;
                if (/^\s+$/.test(tok)) {
                    result.push({ token: tok, isWord: false, clean: '' });
                } else {
                    // strip leading/trailing punctuation for lookup
                    const clean = tok.replace(/^[^a-zA-Z0-9']+|[^a-zA-Z0-9']+$/g, '');
                    result.push({ token: tok, isWord: clean.length > 0, clean: clean });
                }
            }
            return result;
        }

        // ---------- RENDER WORD LIST ----------
        function renderWordList() {
            if (currentWords.length === 0) {
                wordListContainer.innerHTML = `
                    <div class="empty-message">
                        <span>📭</span>
                        No words selected. Choose weeks and tap “Show”.
                    </div>
                `;
                return;
            }

            let html = '';
            currentWords.forEach((wordItem, index) => {
                const isChecked = wordItem.checked;
                const isTouched = touchedIndexes.has(index);
                let cardClass = 'word-card';
                if (isTouched) {
                    cardClass += isChecked ? ' is-right' : ' is-wrong';
                }

                // Build sentence with inline source tags
                const sentenceHtml = buildSentenceHtml(wordItem.sentence, wordItem.text);

                // Build checklist of unique words in the sentence (excluding common)
                const checklistHtml = buildSentenceChecklist(wordItem, index);

                html += `
                    <div class="${cardClass}">
                        <div class="word-card-top">
                            <input type="checkbox" class="check-box" ${isChecked ? 'checked' : ''} data-index="${index}" aria-label="Mark ${escapeHtml(wordItem.text)} as correct">
                            <div class="word-body">
                                <div class="word-row">
                                    <div class="word-text">${escapeHtml(wordItem.text)}</div>
                                    <div class="word-meta">W${wordItem.week}</div>
                                </div>
                                <div class="word-sentence">${sentenceHtml}</div>
                            </div>
                        </div>
                        ${checklistHtml}
                    </div>
                `;
            });

            wordListContainer.innerHTML = html;

            // Attach checkbox listeners for the main word checkbox
            document.querySelectorAll('.check-box').forEach(cb => {
                cb.addEventListener('change', (e) => {
                    const index = parseInt(e.target.dataset.index);
                    if (!isNaN(index) && currentWords[index]) {
                        currentWords[index].checked = e.target.checked;
                        touchedIndexes.add(index);
                        renderWordList();
                        updateScoreSummary();
                    }
                });
            });

            // Attach listeners to sentence word chips
            document.querySelectorAll('.word-chip input[type="checkbox"]').forEach(cb => {
                cb.addEventListener('change', (e) => {
                    const cardIndex = parseInt(e.target.dataset.cardIndex);
                    const wordKey = e.target.dataset.wordKey;
                    if (!isNaN(cardIndex) && currentWords[cardIndex]) {
                        currentWords[cardIndex].sentenceChecks[wordKey] = e.target.checked;
                        // Toggle chip class
                        const chip = e.target.closest('.word-chip');
                        if (chip) {
                            chip.classList.toggle('checked', e.target.checked);
                        }
                    }
                });
            });
        }

        // ---------- BUILD SENTENCE HTML WITH SOURCE TAGS ----------
        function buildSentenceHtml(sentence, targetWord) {
            const tokens = tokenizeSentence(sentence);
            let html = '';
            const targetLower = targetWord.toLowerCase();

            for (const t of tokens) {
                if (!t.isWord) {
                    html += escapeHtml(t.token);
                } else {
                    const lower = t.clean.toLowerCase();
                    const isTarget = lower === targetLower;

                    if (isTarget) {
                        html += `<b>${escapeHtml(t.token)}</b>`;
                    } else {
                        html += escapeHtml(t.token);
                    }

                    // Add source tag if the word is a learned spelling word (not common, not target)
                    if (!isTarget && !commonWords.has(lower) && wordSourceMap[lower] !== undefined) {
                        const srcWeek = wordSourceMap[lower];
                        html += `<span class="source-tag">W${srcWeek}</span>`;
                    }
                }
            }
            return html;
        }

        // ---------- BUILD SENTENCE CHECKLIST ----------
        // Shows unique words from the sentence (excluding common words).
        // Each word gets its own checkbox.
        function buildSentenceChecklist(wordItem, cardIndex) {
            const tokens = tokenizeSentence(wordItem.sentence);
            // Collect unique spelling words in this sentence (target + other learned words)
            const uniqueWords = [];
            const seen = new Set();
            const targetLower = wordItem.text.toLowerCase();

            for (const t of tokens) {
                if (!t.isWord) continue;
                const lower = t.clean.toLowerCase();
                if (seen.has(lower)) continue;
                if (commonWords.has(lower)) continue;   // skip common words
                seen.add(lower);
                uniqueWords.push({
                    display: t.clean,
                    lower: lower,
                    isTarget: lower === targetLower
                });
            }

            if (uniqueWords.length === 0) return '';

            let chipsHtml = '';
            for (const uw of uniqueWords) {
                const checked = wordItem.sentenceChecks[uw.lower] ? 'checked' : '';
                const chipClass = 'word-chip' + (uw.isTarget ? ' is-target' : '') + (checked ? ' checked' : '');
                const tagText = uw.isTarget ? '' : '';
                chipsHtml += `
                    <label class="${chipClass}">
                        <input type="checkbox" ${checked} data-card-index="${cardIndex}" data-word-key="${escapeHtml(uw.lower)}">
                        <span>${escapeHtml(uw.display)}</span>
                        ${tagText}
                    </label>
                `;
            }

            return `
                <div class="sentence-checklist">
                    <div class="checklist-label">✅ Words spelled right in this sentence</div>
                    ${chipsHtml}
                </div>
            `;
        }

        // Helper to escape HTML
        function escapeHtml(unsafe) {
            return String(unsafe).replace(/[&<>"]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                if (m === '"') return '&quot;';
                return m;
            });
        }

        // ---------- UPDATE SCORE SUMMARY ----------
        function updateScoreSummary() {
            if (currentWords.length === 0) {
                resultSummary.classList.remove('show');
                return;
            }
            const total = currentWords.length;
            const marked = touchedIndexes.size;
            const rightCount = currentWords.filter((w, i) => touchedIndexes.has(i) && w.checked).length;
            const wrongCount = marked - rightCount;

            if (marked === 0) {
                resultSummary.classList.remove('show');
                return;
            }

            resultSummary.classList.add('show');
            scoreDisplay.textContent = `${rightCount} / ${total}`;
            scoreDetail.textContent = `${marked} of ${total} marked · ✅ ${rightCount} · ❌ ${wrongCount}`;
        }

        // ---------- RESET ALL ----------
        function resetAll() {
            selectedWeeks.clear();
            currentWords = [];
            touchedIndexes.clear();
            document.querySelectorAll('.week-btn').forEach(btn => btn.classList.remove('active'));
            renderWordList();
            resultSummary.classList.remove('show');
        }

        // ---------- DOWNLOAD RESULTS AS CSV ----------
        function downloadResults() {
            if (currentWords.length === 0) {
                showToast('No words to download. Load words first.');
                return;
            }

            if (touchedIndexes.size === 0) {
                showToast('No words marked yet.');
                return;
            }

            const rows = [];
            rows.push(['#', 'Word', 'Week', 'Sentence', 'Result', 'Sentence Words Marked Right'].join(','));

            currentWords.forEach((wordItem, index) => {
                const num = index + 1;
                const word = csvEscape(wordItem.text);
                const week = wordItem.week;
                const sentence = csvEscape(wordItem.sentence);
                let result;
                if (!touchedIndexes.has(index)) {
                    result = 'Not marked';
                } else if (wordItem.checked) {
                    result = 'Right';
                } else {
                    result = 'Wrong';
                }
                // Sentence words that are checked
                const checkedWords = Object.keys(wordItem.sentenceChecks)
                    .filter(k => wordItem.sentenceChecks[k])
                    .join(' ');
                const checkedStr = csvEscape(checkedWords);
                rows.push([num, word, week, sentence, result, checkedStr].join(','));
            });

            const total = currentWords.length;
            const marked = touchedIndexes.size;
            const rightCount = currentWords.filter((w, i) => touchedIndexes.has(i) && w.checked).length;
            const wrongCount = marked - rightCount;

            rows.push('');
            rows.push(['Summary'].join(','));
            rows.push(['Total words', total].join(','));
            rows.push(['Marked', marked].join(','));
            rows.push(['Right', rightCount].join(','));
            rows.push(['Wrong', wrongCount].join(','));
            rows.push(['Score', `${rightCount}/${total}`].join(','));

            const csvContent = rows.join('\n');
            const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });

            const weeks = Array.from(selectedWeeks).sort((a, b) => a - b);
            const weekStr = weeks.length <= 5
                ? weeks.map(w => `W${w}`).join('-')
                : `W${weeks[0]}-to-W${weeks[weeks.length-1]}`;
            const dateStr = new Date().toISOString().slice(0, 10);
            const filename = `spelling-grade1-${weekStr}-${dateStr}.csv`;

            if (navigator.msSaveBlob) {
                navigator.msSaveBlob(blob, filename);
            } else {
                const link = document.createElement('a');
                if (link.download !== undefined) {
                    const url = URL.createObjectURL(blob);
                    link.setAttribute('href', url);
                    link.setAttribute('download', filename);
                    link.style.visibility = 'hidden';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(url);
                }
            }

            showToast(`⬇ Downloaded ${marked} marked words!`);
        }

        function csvEscape(value) {
            const str = String(value);
            if (str.includes(',') || str.includes('"') || str.includes('\n')) {
                return '"' + str.replace(/"/g, '""') + '"';
            }
            return str;
        }

        // ---------- INITIAL LOAD ----------
        function initApp() {
            selectedWeeks.add(1);
            selectedWeeks.add(2);
            selectedWeeks.add(5);

            renderWeekButtons();
            buildWordList();

            loadBtn.addEventListener('click', (e) => {
                e.preventDefault();
                buildWordList();
            });

            resetBtn.addEventListener('click', (e) => {
                e.preventDefault();
                resetAll();
            });

            downloadBtn.addEventListener('click', (e) => {
                e.preventDefault();
                downloadResults();
            });
        }

        initApp();
    })();
</script>
