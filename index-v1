    <style>
        * {
            box-sizing: border-box;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            margin: 0;
            padding: 0;
        }
        body {
            background: #f5f7fb;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 12px 10px 24px;
        }
        .app-container {
            max-width: 600px;
            margin: 0 auto;
            width: 100%;
            background: white;
            border-radius: 28px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
            padding: 18px 14px 22px;
            border: 1px solid #e9edf4;
        }
        h1 {
            font-size: 1.6rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: #1e2a3e;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
        }
        .subhead {
            color: #5e6f8d;
            font-size: 0.85rem;
            margin-bottom: 18px;
            border-left: 3px solid #3b7cff;
            padding-left: 10px;
            font-weight: 450;
        }
        .filter-section {
            background: #f9faff;
            border-radius: 20px;
            padding: 14px 12px;
            margin-bottom: 18px;
            border: 1px solid #e2e8f2;
        }
        .filter-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            color: #1e2a3e;
            font-size: 0.95rem;
            margin-bottom: 12px;
            letter-spacing: -0.01em;
        }
        .filter-title span {
            background: #d9e3ff;
            border-radius: 30px;
            padding: 2px 10px;
            font-size: 0.75rem;
            color: #1f4fcf;
            font-weight: 600;
        }
        .grade-badge {
            background: #e9eff9;
            border-radius: 40px;
            padding: 5px 12px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #1f4fcf;
            display: inline-block;
        }
        .week-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            justify-content: flex-start;
            max-height: 180px;
            overflow-y: auto;
            padding-bottom: 6px;
            scrollbar-width: thin;
            -webkit-overflow-scrolling: touch;
        }
        .week-btn {
            background: white;
            border: 1.5px solid #d0dae9;
            color: #1e2a3e;
            font-weight: 550;
            padding: 6px 12px;
            border-radius: 30px;
            font-size: 0.78rem;
            cursor: pointer;
            transition: all 0.1s ease;
            flex: 0 0 auto;
            text-align: center;
            min-width: 48px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        .week-btn.active {
            background: #1e2a3e;
            border-color: #1e2a3e;
            color: white;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(30, 42, 62, 0.2);
        }
        .week-btn:active {
            transform: scale(0.96);
        }
        .week-grid::-webkit-scrollbar {
            width: 4px;
        }
        .week-grid::-webkit-scrollbar-thumb {
            background: #c0ccdf;
            border-radius: 20px;
        }
        .action-buttons {
            display: flex;
            gap: 10px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }
        .btn {
            border: none;
            background: #1e2a3e;
            color: white;
            font-weight: 600;
            padding: 14px 14px;
            border-radius: 60px;
            font-size: 0.95rem;
            cursor: pointer;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.15s ease;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.06);
            letter-spacing: -0.01em;
            -webkit-tap-highlight-color: transparent;
            min-width: 110px;
        }
        .btn.secondary {
            background: white;
            color: #1e2a3e;
            border: 1.5px solid #cfdaea;
            box-shadow: none;
        }
        .btn.download {
            background: #1b8c5e;
            color: white;
        }
        .btn.download:active {
            background: #146c48;
        }
        .btn:active {
            transform: scale(0.97);
            background: #0f1a2b;
        }
        .btn.secondary:active {
            background: #f0f4fc;
        }
        .word-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 6px;
            margin-bottom: 16px;
        }
        .word-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 12px 14px;
            border: 1px solid #e3eaf5;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
            transition: all 0.1s ease;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .word-card.is-right {
            border-color: #b8e6cf;
            background: #f6fdf9;
        }
        .word-card.is-wrong {
            border-color: #f5c2c2;
            background: #fff9f9;
        }
        .word-card-top {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .check-box {
            appearance: none;
            width: 32px;
            height: 32px;
            border: 2.5px solid #b6c5db;
            border-radius: 9px;
            margin: 0;
            position: relative;
            transition: all 0.12s ease;
            background: white;
            cursor: pointer;
            flex-shrink: 0;
        }
        .check-box:checked {
            background: #1b8c5e;
            border-color: #1b8c5e;
        }
        .check-box:checked::after {
            content: "";
            position: absolute;
            left: 8px;
            top: 3px;
            width: 8px;
            height: 16px;
            border: solid white;
            border-width: 0 3.5px 3.5px 0;
            transform: rotate(45deg);
        }
        .check-box:active {
            transform: scale(0.94);
        }
        .word-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 3px;
            min-width: 0;
        }
        .word-row {
            display: flex;
            align-items: baseline;
            gap: 8px;
            flex-wrap: wrap;
        }
        .word-text {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: #0f1a2b;
            line-height: 1.15;
            word-break: break-word;
        }
        .word-meta {
            font-size: 0.62rem;
            background: #eef3fc;
            color: #3760a8;
            padding: 2px 8px;
            border-radius: 40px;
            font-weight: 600;
            white-space: nowrap;
        }
        .word-sentence {
            font-size: 0.9rem;
            color: #5c6d8a;
            line-height: 1.45;
            font-weight: 450;
            font-style: italic;
        }
        .word-sentence b {
            color: #1b4bcf;
            font-weight: 700;
            font-style: normal;
        }
        /* Word source tag (grade/week where the word was learned) */
        .source-tag {
            font-size: 0.6rem;
            background: #fef3c7;
            color: #92400e;
            padding: 1px 6px;
            border-radius: 20px;
            font-weight: 700;
            white-space: nowrap;
            font-style: normal;
            vertical-align: middle;
            margin-left: 2px;
            border: 1px solid #fcd34d;
        }
        .source-tag.new {
            background: #dbeafe;
            color: #1e40af;
            border-color: #93c5fd;
        }
        /* Sentence word checklist at bottom */
        .sentence-checklist {
            background: #f8faff;
            border: 1px solid #e2e9f2;
            border-radius: 12px;
            padding: 10px 10px 8px;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            align-items: center;
        }
        .checklist-label {
            font-size: 0.68rem;
            color: #6a7b99;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            width: 100%;
            margin-bottom: 2px;
        }
        .word-chip {
            display: flex;
            align-items: center;
            gap: 5px;
            background: white;
            border: 1.5px solid #d0dae9;
            border-radius: 30px;
            padding: 4px 10px 4px 6px;
            font-size: 0.82rem;
            font-weight: 600;
            color: #3e4f6b;
            cursor: pointer;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            transition: all 0.12s ease;
        }
        .word-chip:active {
            transform: scale(0.96);
        }
        .word-chip.checked {
            background: #e2f6ec;
            border-color: #1b8c5e;
            color: #116b47;
        }
        .word-chip input[type="checkbox"] {
            appearance: none;
            width: 18px;
            height: 18px;
            border: 2px solid #b6c5db;
            border-radius: 5px;
            margin: 0;
            position: relative;
            transition: all 0.12s ease;
            background: white;
            cursor: pointer;
            flex-shrink: 0;
        }
        .word-chip input[type="checkbox"]:checked {
            background: #1b8c5e;
            border-color: #1b8c5e;
        }
        .word-chip input[type="checkbox"]:checked::after {
            content: "";
            position: absolute;
            left: 5px;
            top: 1px;
            width: 4px;
            height: 9px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }
        .word-chip.is-target {
            background: #e0ecff;
            border-color: #3b7cff;
            color: #1b4bcf;
        }
        .word-chip.is-target.checked {
            background: #d6f5e5;
            border-color: #1b8c5e;
            color: #116b47;
        }
        .result-summary {
            background: #eef6ff;
            border-radius: 18px;
            padding: 14px 12px;
            margin-bottom: 14px;
            text-align: center;
            font-weight: 500;
            color: #1e2a3e;
            border: 1px solid #d2e0ff;
            display: none;
            flex-direction: column;
            gap: 6px;
        }
        .result-summary.show {
            display: flex;
        }
        .score-big {
            font-size: 1.9rem;
            font-weight: 800;
            color: #1b4bcf;
            line-height: 1.2;
        }
        .empty-message {
            text-align: center;
            padding: 36px 14px;
            background: #f9fbfe;
            border-radius: 24px;
            color: #6a7b99;
            font-weight: 500;
            border: 1px dashed #cbd6e8;
            margin-bottom: 12px;
            font-size: 0.9rem;
        }
        .empty-message span {
            font-size: 1.8rem;
            display: block;
            margin-bottom: 6px;
            opacity: 0.6;
        }
        .legend {
            display: flex;
            gap: 12px;
            justify-content: center;
            font-size: 0.72rem;
            color: #5e6f8d;
            font-weight: 500;
            margin-bottom: 12px;
            flex-wrap: wrap;
            text-align: center;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .legend-box {
            width: 13px;
            height: 13px;
            border-radius: 4px;
            border: 2px solid #b6c5db;
            background: white;
        }
        .legend-box.checked {
            background: #1b8c5e;
            border-color: #1b8c5e;
            position: relative;
        }
        .legend-box.checked::after {
            content: "";
            position: absolute;
            left: 3px;
            top: 0px;
            width: 4px;
            height: 7px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }
        .footer-note {
            font-size: 0.72rem;
            color: #8a99b4;
            text-align: center;
            margin-top: 12px;
            padding-top: 8px;
            border-top: 1px solid #ecf0f7;
        }
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #1e2a3e;
            color: white;
            padding: 14px 24px;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.95rem;
            box-shadow: 0 12px 30px rgba(0,0,0,0.2);
            opacity: 0;
            transition: all 0.3s ease;
            z-index: 999;
            pointer-events: none;
            white-space: nowrap;
        }
        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>
<div class="app-container">
    <h1>📖 Spelling</h1>
    <div class="subhead">Grade 1 · Tap each word in the sentence you spelled correctly</div>

    <!-- Grade display -->
    <div class="filter-section">
        <div class="filter-title">📚 Grade</div>
        <div class="grade-badge">Grade 1 (Master Spelling List)</div>
    </div>

    <!-- Week selector -->
    <div class="filter-section">
        <div class="filter-title">📅 Week <span>1–36, multi-select</span></div>
        <div class="week-grid" id="weekGrid"></div>
    </div>

    <!-- Action buttons -->
    <div class="action-buttons">
        <button class="btn" id="loadBtn" aria-label="Show words">🔍 Show</button>
        <button class="btn secondary" id="resetBtn" aria-label="Reset selections">↻ Reset</button>
    </div>
    <div class="action-buttons">
        <button class="btn download" id="downloadBtn" aria-label="Download results">⬇ Download CSV</button>
    </div>

    <!-- Legend -->
    <div class="legend">
        <div class="legend-item">
            <div class="legend-box checked"></div>
            <span>Checked = Right</span>
        </div>
        <div class="legend-item">
            <div class="legend-box"></div>
            <span>Unchecked = Wrong</span>
        </div>
        <div class="legend-item">
            <span class="source-tag">W1</span>
            <span>= learned in that week</span>
        </div>
    </div>

    <!-- Result summary -->
    <div class="result-summary" id="resultSummary">
        <div class="score-big" id="scoreDisplay">0 / 0</div>
        <div id="scoreDetail">Words marked</div>
    </div>

    <!-- Word list container -->
    <div id="wordListContainer" class="word-list">
        <div class="empty-message">
            <span>📝</span>
            Select weeks & tap “Show”
        </div>
    </div>

    <div class="footer-note">
        ✅ Check the word box + each sentence word you spelled right
    </div>
</div>

<!-- Toast notification -->
<div class="toast" id="toast">Downloaded!</div>

